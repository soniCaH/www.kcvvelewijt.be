{
  "name": "@kcvv/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsgo --noEmit && tsgo --noEmit -p tsconfig.vitest.json",
    "build": "tsgo --build && tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@effect/platform": "0.97.2",
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
