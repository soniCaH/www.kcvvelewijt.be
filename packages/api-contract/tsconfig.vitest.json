{
  // Type-checks the tooling config that the production program (tsconfig.json,
  // `src/**` only, composite/emitting) deliberately leaves out, so `build`
  // never emits it into `dist`. Mirrors apps/api's tsconfig.workerd-test.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vitest.config.ts"]
}
