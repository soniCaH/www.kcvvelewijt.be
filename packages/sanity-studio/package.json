    "lint": "eslint .",
    "check-all": "pnpm type-check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@kcvv/sanity-schemas": "workspace:*"
  },
  "peerDependencies": {
    "@sanity/icons": "5.2.1",
    "@sanity/ui": "4.0.7",
    "react": "19.2.8",
    "sanity": "6.11.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "@sanity/icons": "5.2.1",
    "@sanity/ui": "4.0.7",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "happy-dom": "20.11.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.11.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
