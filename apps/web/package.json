{
  "name": "@kcvv/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:clear-cache": "vitest --clearCache",
    "test:no-cache": "vitest run --no-cache",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c test/e2e/playwright.config.ts --ui",
    "test:e2e:install": "playwright install chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-all": "npm run lint && npm run type-check && npm run test && npm run build",
    "fixtures:sync": "tsx scripts/sync-fixture-images.ts",
    "vr:build-storybook": "rm -rf storybook-static && storybook build",
    "vr:run": "concurrently -k -s first --hide 0 \"http-server ./storybook-static -p 6006 -a 127.0.0.1 --silent --cors\" \"wait-on --timeout 60000 tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --index-json --testTimeout 120000 --includeTags vr --excludeTags vr-skip\"",
    "vr:run:update": "concurrently -k -s first --hide 0 \"http-server ./storybook-static -p 6006 -a 127.0.0.1 --silent --cors\" \"wait-on --timeout 60000 tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --index-json --testTimeout 120000 --includeTags vr --excludeTags vr-skip -u\"",
    "vr:run:single": "concurrently -k -s first --hide 0 \"http-server ./storybook-static -p 6006 -a 127.0.0.1 --silent --cors\" \"wait-on --timeout 60000 tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --index-json --testTimeout 120000 --includeTags vr --excludeTags vr-skip --maxWorkers=1\"",
    "vr:check": "node scripts/vr-docker.mjs check",
    "vr:update": "node scripts/vr-docker.mjs update",
    "vr:update:single": "node scripts/vr-docker.mjs update:single",
    "vr:update:story": "node scripts/vr-docker.mjs update:story",
    "vr:ci": "pnpm run vr:run",
    "vr:ci:update": "pnpm run vr:run:update",
    "vr:diff": "node scripts/vr-diff.mjs"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@kcvv/api-contract": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@portabletext/react": "8.0.1",
    "@sanity/client": "7.26.2",
    "@sanity/webhook": "4.0.4",
    "@tailwindcss/typography": "0.5.20",
    "@touch4it/ical-timezones": "1.9.0",
    "clsx": "2.1.1",
    "effect": "3.22.1",
    "groq": "6.11.0",
    "html-to-image": "1.11.13",
    "ical-generator": "11.1.1",
    "luxon": "3.7.2",
    "next": "16.3.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "tailwind-merge": "3.6.0",
    "vanilla-cookieconsent": "3.1.0",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@kcvv/sanity-schemas": "workspace:*",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@storybook/test-runner": "0.24.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/jest-image-snapshot": "6.4.1",
    "@types/luxon": "3.7.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-storybook": "10.5.10",
    "happy-dom": "20.11.12",
    "http-server": "14.1.1",
    "jest-image-snapshot": "6.5.2",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.0.0",
    "sharp": "0.35.4",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "6.0.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
