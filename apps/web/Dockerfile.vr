# syntax=docker/dockerfile:1
#
# Visual-regression runner image. Pinned to match @playwright/test version in
# apps/web/package.json (1.60.0). When upgrading Playwright bump BOTH the npm
# dep and this FROM tag together — drift produces silent font-rendering diffs.
#
# Build context is the repo root (see apps/web/docker-compose.vr.yml) so the
# workspace manifests can be copied for a cached pnpm install layer.

FROM mcr.microsoft.com/playwright:v1.60.0-noble

# Content-addressed staleness check (#3141): `vr:build-image` (apps/web/scripts/
# vr-build-image.mjs) stamps this label with a hash of pnpm-lock.yaml +
# Dockerfile.vr. vr-docker.mjs recomputes that hash before every local run and
# fails fast, naming the rebuild command, when it does not match the image's
# label — a lockfile or Dockerfile change no longer silently runs against a
# stale image now that `--build` is gone from the per-run command.
ARG VR_IMAGE_CONTENT_HASH=unknown
LABEL kcvv.vr-content-hash=$VR_IMAGE_CONTENT_HASH

ENV CI=true \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PNPM_HOME=/root/.local/share/pnpm \
    PATH=/root/.local/share/pnpm:$PATH

RUN corepack enable \
    && corepack prepare pnpm@10.33.2 --activate

WORKDIR /work

# Workspace manifests first for a cacheable install layer.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY apps/studio/package.json apps/studio/
COPY apps/studio-staging/package.json apps/studio-staging/
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/sanity-schemas/package.json packages/sanity-schemas/
COPY packages/sanity-studio/package.json packages/sanity-studio/

# Only @kcvv/web's node_modules is needed at runtime — narrow the install to
# its filter graph to keep the image small.
RUN pnpm install --frozen-lockfile --ignore-scripts \
    --filter=@kcvv/web... \
    --filter=@kcvv/api-contract \
    --filter=@kcvv/sanity-schemas \
    --filter=@kcvv/sanity-studio

WORKDIR /work/apps/web

# Serves the prebuilt Storybook on 127.0.0.1:6006, waits for it, then runs the
# test-runner. Extra args (e.g. --update-snapshots) are forwarded via "$@".
# `vr:run` is defined in apps/web/package.json so the same orchestration works
# in CI without docker (see .github/workflows/ci.yml visual-regression job).
# No --includeTags/--excludeTags here (#3188, review round 2): ONE run visits
# EVERY story now, sharded — `.storybook/test-runner.ts`'s `postVisit` decides
# per story whether to screenshot (carries `vr`, not `vr-skip`, no
# `parameters.vr.disable`) or just run the a11y check (everything else),
# instead of a CLI tag filter deciding which stories get visited at all. That
# closed a real gap: a story combining an inherited `vr` tag with a per-story
# `vr-skip` used to get no axe check from either of two complementary
# invocations this repo ran before.
#
# Argument flow:
#   `docker compose run --rm vr <ARGS>`
#     → ENTRYPOINT becomes: ["sh","-c","...$*","--", <ARGS>]
#     → `--` is the script's $0, so $* expands to <ARGS> (e.g. "-u" for
#       --update-snapshots), appended after the base test-storybook flags.
#   The `vr:*` scripts go through apps/web/scripts/vr-docker.mjs, which owns
#   that arg list — `vr:update:story -- ui-button` appends `-u -- ui-button`.
#   It also refuses an unscoped run before this image is built (#2380).
# `--testTimeout 120000` covers the heavier MDX-backed Foundation reference
# stories (icon catalogue, type scale) — the default 15s flakes when the
# runner is under load. Raised to 120s so it stays comfortably above the
# `INITIAL_NAVIGATION_TIMEOUT_MS` that `.storybook/test-runner.ts` gives the one
# `iframe.html` navigation — Jest must not kill the hook before Playwright's own
# navigation budget runs out, or the real cause is hidden (#2721). Keep this in
# step with the `vr:run*` scripts in package.json — local and CI stay identical.
ENTRYPOINT ["sh", "-c", "exec pnpm exec concurrently -k -s first --hide 0 \"http-server ./storybook-static -p 6006 -a 127.0.0.1 --silent --cors\" \"wait-on --timeout 60000 tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --index-json --testTimeout 120000 $*\"", "--"]
