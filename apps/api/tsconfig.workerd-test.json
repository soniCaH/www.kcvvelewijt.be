{
  // Type-checks *.workerd.test.ts + the workerd-only test helpers, kept OUT
  // of tsconfig.json (the production type-check) because
  // workerd-test-env.d.ts declares a global `Env`/`Cloudflare.GlobalProps`
  // ambient type — generated by `wrangler types` for the TEST-ONLY
  // wrangler.workerd-test.jsonc, and scoped to exactly the two files that
  // actually run under the "workers" Vitest project (#3145 review).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src/**/*.workerd.test.ts",
    "src/test-helpers/workerd-entry.ts",
    "src/test-helpers/workerd-test-env.d.ts"
  ],
  // "include"/"exclude" are replaced wholesale by a descendant config, never
  // merged with the base's — an empty array here is deliberate, not a
  // no-op: without it, tsconfig.json's own "exclude" above (which excludes
  // exactly these three files) would still apply and filter this config's
  // "include" straight back down to nothing.
  "exclude": []
}
