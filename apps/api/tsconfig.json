{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "vitest.config.ts",
    "vitest.node.config.ts",
    "vitest.workers.config.ts"
  ],
  // *.workerd.test.ts and the workerd-only test helpers carry their own
  // ambient `Env`/`Cloudflare.GlobalProps` globals (workerd-test-env.d.ts,
  // generated by `wrangler types` for the TEST-ONLY wrangler config) — the
  // production type-check must never see a test-only global `Env`.
  // tsconfig.workerd-test.json covers these instead (see its own comment).
  "exclude": [
    "src/**/*.workerd.test.ts",
    "src/test-helpers/workerd-entry.ts",
    "src/test-helpers/workerd-test-env.d.ts"
  ]
}
