{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // #2934 — unused-code detectors are now on (default mode: exports + files +
  // dependencies). Config decisions recorded here so a re-run stays readable:
  //
  // 1. Barrels are NOT declared as entry points. An unconsumed re-export in a
  //    barrel is still worth flagging here — but the trim is not automatic.
  //    Ruled by the design-system owner on #3025 (2026-09-21), closing the
  //    re-decide #2934 left open: **a component with a story belongs in its
  //    barrel**, full stop — a barrel is the client-safe public API, not
  //    "only what something in this repo currently imports". The one
  //    exception is a component that cannot run in a browser bundle because
  //    it, or something it renders, does server-only work (e.g.
  //    `MatchStripSlot`, absent from `@/components/layout` because it
  //    renders the async, BFF-reading `<MatchStrip>` — see that barrel's own
  //    comment). A barrel export with no story and no consumer is still
  //    dead weight and gets trimmed. The superseded basis for the old
  //    "trim on unconsumed" policy — that an unread re-export "forces a
  //    component into the shared webpack chunk on every route" — doesn't
  //    apply: apps/web's package.json declares
  //    `"sideEffects": ["**/*.css"]` (#2935/#2956, landed 2026-09-14), so
  //    everything but CSS is tree-shakeable regardless of barrel exports.
  //    That bundle-cost narrative is gone from this file and from the
  //    `Alert` barrel's docblock (apps/web/src/components/design-system/
  //    Alert/index.ts), which is where it originated. See point 3 for why
  //    `.design-sync/entry.ts`'s wildcard is the real consumer that makes
  //    "unconsumed" the wrong test for these two barrels in the first
  //    place.
  // 2. `types` (unused exported TYPE, not field) is excluded globally below.
  //    It carries no runtime cost (erased at build) and is 616 of ~900
  //    findings, almost entirely barrel type re-exports mirroring the same
  //    value exports. Re-enable per-run with `knip --include types` if this
  //    needs auditing later.
  // 3. `scripts/`, `.design-sync/` and friends get explicit entry points
  //    below so their manually-invoked files (tsx one-offs, the design-sync
  //    converter bundle) stop reading as orphaned — they were never entry
  //    points, not dead code. `.design-sync/entry.ts` and dts-entry.d.ts
  //    ARE included in this (see the "entry" array below) even though both
  //    do `export * from "@/components/design-system"` / ".../layout": that
  //    wildcard is a REAL consumer (design-sync bundles the whole barrel
  //    onto `window.KcvvDS` for the design tool; `.design-sync/config.json`'s
  //    `overrides` names specific components from both barrels), not a
  //    loophole to route around. Marking them non-entries and hiding the
  //    resulting "orphaned file" report via `ignoreIssues` (an earlier
  //    version of this config did exactly that) hides the real usage
  //    instead of counting it — the barrel trims it produced were wrong,
  //    caught in review. `design-system/index.ts` and `layout/index.ts`
  //    (plus the sub-barrels they source from: ScrollHint, SectionTransition,
  //    EditorialLead, MonoStar) keep every value export design-sync's
  //    wildcard reaches, even ones with no *other* consumer.
  // 4. `--production` mode was measured and made things worse (1066 vs 892)
  //    because test files stop being entry points. Default mode stays the
  //    base; not adopting `--production`.
  "exclude": ["types"],
  "ignoreIssues": {
    // Generated by `sanity typegen`; exports every schema type by contract.
    "apps/web/src/lib/sanity/sanity.types.ts": ["exports", "types"],
    // dts-entry.d.ts (declared as an entry below) re-exports from
    // dist-types/ — gitignored, generated by
    // `tsc -p .design-sync/tsconfig.dts.json`, and absent on a fresh
    // checkout. Scoped to `unresolved` only (never `files`) as a defensive
    // measure — empirically, this knip version doesn't flag `export *`
    // targets in a .d.ts as unresolved even when the target is missing, so
    // this entry is a no-op today, but it's the correct narrow tool if that
    // ever changes, and costs nothing to leave in place.
    ".design-sync/dts-entry.d.ts": ["unresolved"],
    // Playwright loads this reporter via a config file-path string
    // (test/e2e/playwright.config.ts), not a static import — the default
    // export has no import site knip can see. See the comment on
    // `GithubSummaryReporter` itself.
    "apps/web/test/reporters/github-summary.ts": ["exports"],
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "prettier-plugin-tailwindcss",
        // scripts/board-cleanup, /responsibility-seeding, /staff-cleanup and
        // /team-image-backfill are standalone npm (not pnpm-workspace)
        // mini-projects, each with its own package.json + package-lock.json
        // declaring @sanity/client.
        "@sanity/client",
      ],
      "ignoreBinaries": [
        // scripts/create-ga4-dimensions.mjs and scripts/sync-gtm.mjs shell
        // out to the gcloud CLI (see apps/web/CLAUDE.md's Analytics
        // checklist) — a local dev tool, not a repo dependency.
        "gcloud",
      ],
      "entry": [
        // `entry` REPLACES knip's root-workspace defaults
        // (`{index,cli,main}.{ext}` / `src/{index,cli,main}.{ext}`) rather
        // than merging with them — they are omitted here, not forgotten:
        // this repo has no top-level index/cli/main.ts nor a root src/, so
        // both patterns matched nothing even before this file existed
        // (confirmed via `knip --debug`); re-adding them only produces a
        // "no matches" configuration hint on every run.
        // scripts/ — every file here is run by hand (`tsx src/…`, `node
        // scripts/….mjs`, `./scripts/….sh`); none are wired into any
        // package.json script, so they read as orphaned without this.
        "scripts/*.mjs",
        "scripts/*/src/**/*.ts",
        // One-off screenshot/composite scripts for a design mockup, run by
        // hand per mockup folder; `_`-prefixed by convention (see
        // docs/design/mockups/phase-3-b-editorial-hero/screenshots/). Also
        // what makes "playwright" (imported by `_shoot.mjs`/`_capture*.mjs`)
        // resolvable without an `ignoreDependencies` entry.
        "docs/design/mockups/**/_*.mjs",
      ],
    },
    // .design-sync/ has its own package.json (`@kcvv/web-dssync`) and is a
    // real knip workspace even though it's not in pnpm-workspace.yaml's
    // globs (knip's own `workspaces` keys don't require that — see
    // ConfigurationChief#getAdditionalWorkspaceNames). Kept separate from
    // "." specifically so `react` and `@ds-stories/apps` — real only for
    // this tool's preview/shim files — don't blind the root workspace's
    // dependency check to a genuine future `react` import anywhere else at
    // repo root (#2934 review finding 4).
    ".design-sync": {
      "ignoreDependencies": [
        "react",
        // .design-sync's preview files import story modules through an
        // esbuild-only path alias (.design-sync/tsconfig.build.json) that
        // resolves nowhere in this repo's own tsconfig.
        "@ds-stories/apps",
      ],
      "entry": [
        // Consumed by an external tool (the Claude "design sync"
        // connector), not by anything in this repo's own build. See
        // .design-sync/NOTES.md for what reads each file. entry.ts and
        // dts-entry.d.ts wildcard-export the design-system/layout barrels
        // for that tool — genuine usage knip should trace, not hide (see
        // decision 3 in the top comment). dts-entry.d.ts is NOT listed
        // explicitly: package.json's own `"types": "./dts-entry.d.ts"`
        // already makes knip treat it as an entry (confirmed — declaring it
        // here too produced a "redundant entry pattern" hint).
        "entry.ts",
        "gen-build-tsconfig.mjs",
        "previews/**/*.{ts,tsx}",
        "shims/**/*.{ts,tsx}",
      ],
    },
    "apps/api": {
      "ignoreBinaries": ["jq"],
      "ignoreDependencies": ["cloudflare"],
    },
    "apps/studio": {
      "entry": [
        "structure.ts",
        // Migrations run via the Sanity CLI (`sanity migrate <name>`), which
        // discovers them by directory convention — nothing in the app
        // imports them.
        "migrations/*/index.ts",
        // One-off tsx scripts, run by hand.
        "scripts/*.ts",
      ],
      "ignoreDependencies": ["prettier"],
    },
    "apps/studio-staging": {
      "entry": ["structure.ts", "migrations/*/index.ts"],
      "ignoreDependencies": ["prettier"],
    },
    "apps/web": {
      "entry": [
        // Scoped Storybook config for the design-sync converter — loaded by
        // Storybook via its own config resolution, not imported.
        ".sb-dssync/main.ts",
        ".sb-dssync/preview.ts",
        // Storybook / test-runner config, loaded by convention.
        ".storybook/allow-module-register.cjs",
        ".storybook/test-runner-jest.config.mjs",
        // One-off seed/audit scripts, run by hand via `tsx`/`node`.
        "scripts/*.mjs",
        "scripts/seeds/*.mjs",
      ],
    },
  },
}
