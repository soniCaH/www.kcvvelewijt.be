{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // #2934 — unused-code detectors are now on (default mode: exports + files +
  // dependencies). Config decisions recorded here so a re-run stays readable:
  //
  // 1. Barrels are NOT declared as entry points. An unconsumed re-export in a
  //    barrel is a real defect here — the `Alert` barrel's docblock
  //    (apps/web/src/components/design-system/Alert/index.ts) already
  //    documents the cost: an unused re-export forces a component into the
  //    shared webpack chunk on every route (no "sideEffects": false, no
  //    optimizePackageImports for this package). Barrel `exports` findings
  //    are triaged like any other — trimmed to what a consumer actually
  //    imports through that path, not exempted.
  // 2. `types` (unused exported TYPE, not field) is excluded globally below.
  //    It carries no runtime cost (erased at build) and is 616 of ~900
  //    findings, almost entirely barrel type re-exports mirroring the same
  //    value exports. Re-enable per-run with `knip --include types` if this
  //    needs auditing later.
  // 3. `scripts/` and `.design-sync/` get explicit entry points below so
  //    their manually-invoked files (tsx one-offs, the design-sync converter
  //    bundle) stop reading as orphaned — they were never entry points, not
  //    dead code.
  // 4. `--production` mode was measured and made things worse (1066 vs 892)
  //    because test files stop being entry points. Default mode stays the
  //    base; not adopting `--production`.
  "exclude": ["types"],
  "ignoreIssues": {
    // Generated by `sanity typegen`; exports every schema type by contract.
    "apps/web/src/lib/sanity/sanity.types.ts": ["exports", "types"],
    // NOT declared as `entry` (unlike the rest of .design-sync/) on purpose:
    // both files do `export * from "@/components/design-system"` /
    // ".../layout" to hand the external design-sync converter a full
    // export surface. Marking either an entry makes knip treat that
    // wildcard re-export as real usage, which silently zeroes out the
    // exact barrel-export findings (apps/web/src/components/design-system
    // and .../layout, 27 exports between them) this issue exists to catch —
    // caught empirically: default-mode `exports` dropped by those 27 the
    // moment entry.ts was added as an entry. `ignoreIssues` only silences
    // their own "orphaned file" report; it does not seed reachability.
    ".design-sync/entry.ts": ["files"],
    // dts-entry.d.ts re-exports from dist-types/ (gitignored, generated by
    // `tsc -p .design-sync/tsconfig.dts.json`; absent on a fresh checkout),
    // so declaring it an entry would also report unresolved imports.
    ".design-sync/dts-entry.d.ts": ["files"]
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "prettier-plugin-tailwindcss",
        "playwright",
        // Declaring scripts/ and .design-sync/ as entries (below) makes knip
        // trace their imports for the first time, surfacing dependencies
        // that live outside this workspace's own package.json on purpose:
        "react",
        // .design-sync's preview files import story modules through an
        // esbuild-only path alias (.design-sync/tsconfig.build.json) that
        // resolves nowhere in this repo's own tsconfig.
        "@ds-stories/apps",
        // scripts/board-cleanup, /responsibility-seeding, /staff-cleanup and
        // /team-image-backfill are standalone npm (not pnpm-workspace)
        // mini-projects, each with its own package.json + package-lock.json
        // declaring @sanity/client.
        "@sanity/client"
      ],
      "ignoreBinaries": [
        // scripts/create-ga4-dimensions.mjs and scripts/sync-gtm.mjs shell
        // out to the gcloud CLI (see apps/web/CLAUDE.md's Analytics
        // checklist) — a local dev tool, not a repo dependency.
        "gcloud"
      ],
      "entry": [
        // `entry` REPLACES knip's root-workspace defaults
        // (`{index,cli,main}.{ext}` / `src/{index,cli,main}.{ext}`) rather
        // than merging with them — they are omitted here, not forgotten:
        // this repo has no top-level index/cli/main.ts nor a root src/, so
        // both patterns matched nothing even before this file existed
        // (confirmed via `knip --debug`); re-adding them only produces a
        // "no matches" configuration hint on every run.
        // scripts/ — every file here is run by hand (`tsx src/…`, `node
        // scripts/….mjs`, `./scripts/….sh`); none are wired into any
        // package.json script, so they read as orphaned without this.
        "scripts/*.mjs",
        "scripts/*/src/**/*.ts",
        // .design-sync/ — consumed by an external tool (the Claude "design
        // sync" connector), not by anything in this repo's own build. See
        // .design-sync/NOTES.md for what reads each file.
        // (entry.ts and dts-entry.d.ts are declared via ignoreIssues below,
        // not here — see the comment there for why.)
        ".design-sync/gen-build-tsconfig.mjs",
        ".design-sync/previews/**/*.{ts,tsx}",
        ".design-sync/shims/**/*.{ts,tsx}",
        // One-off screenshot/composite scripts for a design mockup, run by
        // hand per mockup folder; `_`-prefixed by convention (see
        // docs/design/mockups/phase-3-b-editorial-hero/screenshots/).
        "docs/design/mockups/**/_*.mjs"
      ]
    },
    "apps/api": {
      "ignoreBinaries": ["jq"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/studio": {
      "entry": [
        "structure.ts",
        // Migrations run via the Sanity CLI (`sanity migrate <name>`), which
        // discovers them by directory convention — nothing in the app
        // imports them.
        "migrations/*/index.ts",
        // One-off tsx scripts, run by hand.
        "scripts/*.ts"
      ],
      "ignoreDependencies": ["prettier"]
    },
    "apps/studio-staging": {
      "entry": [
        "structure.ts",
        "migrations/*/index.ts"
      ],
      "ignoreDependencies": ["prettier"]
    },
    "apps/web": {
      "entry": [
        // Scoped Storybook config for the design-sync converter — loaded by
        // Storybook via its own config resolution, not imported.
        ".sb-dssync/main.ts",
        ".sb-dssync/preview.ts",
        // Storybook / test-runner config, loaded by convention.
        ".storybook/allow-module-register.cjs",
        ".storybook/test-runner-jest.config.mjs",
        // One-off seed/audit scripts, run by hand via `tsx`/`node`.
        "scripts/*.mjs",
        "scripts/seeds/*.mjs"
      ]
    }
  }
}
