{
  "name": "kcvv",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "lint:sh": "git ls-files -z '*.sh' '.husky/*' | xargs -0 shellcheck",
    "knip": "knip --include dependencies,devDependencies,optionalPeerDependencies,unlisted,binaries",
    "knip:code": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "playwright": "1.64.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "sh -c 'cd apps/web && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "apps/web/**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/api/**/*.{js,mjs,ts}": [
      "eslint --fix --config apps/api/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/api/**/*.{json,md}": [
      "prettier --write"
    ],
    "scripts/sanity-ops/**/*.ts": [
      "eslint --fix --config scripts/sanity-ops/eslint.config.mjs",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
